NODE_ENV=development
PORT=4001

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/api_v2_db

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4001/api/auth/google/callback
# Optional: callback for the mobile app when a phone can't reach GOOGLE_CALLBACK_URL (localhost).
# Point it at a tunnel to this API, e.g. https://<name>.ngrok-free.app/api/auth/google/callback,
# and register it with Google too. Defaults to GOOGLE_CALLBACK_URL.
GOOGLE_MOBILE_CALLBACK_URL=
# Deep-link schemes the mobile app may be sent back to after Google sign-in (app.json "scheme")
MOBILE_APP_SCHEMES=myauthmobile

# Frontend
FRONTEND_ORIGIN=http://localhost:3000
# Shared with the web app; lets the API trust the visitor IP the web /api proxy forwards
# (rate limiting and session IPs). Generate with: openssl rand -hex 32
PROXY_SECRET=

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com

# Cloudinary (avatar, role image and site asset uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
