# API URL without the /api prefix. API runs on port 8000 (see apps/api/.env PORT).
# Android emulator: http://10.0.2.2:8000
# iOS simulator / web: http://localhost:8000
# Physical device: http://YOUR_COMPUTER_LAN_IP:8000 (must be on same network; API must allow this origin via FRONTEND_ORIGIN/CORS)
# Release builds refuse anything but https://, e.g. https://api.example.com
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:8000
